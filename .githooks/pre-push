#!/bin/sh

set -e

echo "Running pre-push checks..."

# ------------------------------------------------------------
# clang-format
# ------------------------------------------------------------

echo "[1/3] Checking formatting..."

clang-format \
    --dry-run \
    --Werror \
    --style=file:Norms/.clang-format \
    $(find src -type f \( -name "*.cpp" -o -name "*.hpp" \))

# ------------------------------------------------------------
# CMake build
# ------------------------------------------------------------

echo "[2/3] Building project..."

cmake -S . -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
cmake --build build --parallel

# ------------------------------------------------------------
# clang-tidy
# ------------------------------------------------------------

echo "[3/3] Running clang-tidy..."

find src -type f -name '*.cpp' -print0 |
    xargs -0 -r clang-tidy \
        -p build \
        --config-file=Norms/.clang-tidy

echo "All checks passed."