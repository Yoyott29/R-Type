#!/bin/sh
# Format: [name] [branch] Type: message
# Example: [E.DU] [Test_Branch] Feat: added a test

msg_file="$1"
first_line=$(head -n 1 "$msg_file")

# Let merge, revert, fixup and squash commits through
case "$first_line" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^\[[A-Z]\.[A-Z]{2}\] \[[^]]+\] (Feat|Fix|Refactor|Docs|Style|Chore): .+'

if ! printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
    echo "Invalid commit message:"
    echo "  $first_line"
    echo
    echo "Expected: [name] [branch] Type: message"
    echo "Example:  [E.DU] [Test_Branch] Feat: added a test"
    echo "Types:    Feat, Fix, Refactor, Docs, Style, Chore"
    exit 1
fi

# Check that the branch in the message is the real branch
branch=$(git rev-parse --abbrev-ref HEAD)
msg_branch=$(printf '%s\n' "$first_line" | sed -E 's/^\[[^]]+\] \[([^]]+)\].*/\1/')

if [ "$branch" != "HEAD" ] && [ "$msg_branch" != "$branch" ]; then
    echo "Branch name mismatch:"
    echo "  message says: [$msg_branch]"
    echo "  current branch: [$branch]"
    exit 1
fi